ENVIRONMENT=development
DEBUG=true

# --- Mistral ---
# Ma clé API Mistral (tier gratuit "Experiment" suffit pour développer).
MISTRAL_API_KEY=Ma_cle_ici
MISTRAL_MODEL=mistral-small-latest

# --- Redis (laisser tel quel si tu utilises Docker plus tard) ---
REDIS_URL=redis://localhost:6379/0

# --- Stockage local ---
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_PER_PDF=200

# --- Seuils du pipeline (score de confiance) ---
CONFIDENCE_THRESHOLD_OK=0.85
CONFIDENCE_THRESHOLD_LLM_FALLBACK=0.60